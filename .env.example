# Vercel POS project (one per environment), Production variables:
# that environment's values. Both are public build configuration.
# The build derives dist/_headers CSP and realtime origin from this exact URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Legacy public anon JWT key only; NEVER service-role or secret keys.
VITE_SUPABASE_ANON_KEY=your-public-anon-key
