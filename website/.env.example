# Copy only public configuration to the matching Vercel environment.
# Per environment: staging project's URL/key in develop Preview overrides;
# production project's URL/key in Production. Public anon key ONLY, never service role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Per environment: https://staging.<domain> or https://<domain> (local: below).
NEXT_PUBLIC_SITE_URL=https://ladyvogue.pk
# Optional public GA4 ID, per environment. Leave blank at launch; consent required.
NEXT_PUBLIC_ANALYTICS_ID=
# Server-only configuration, per environment, not a credential.
# Exact verified HTTPS checkout origins. EMPTY for COD-only launch.
PAYMENT_CHECKOUT_ORIGINS=
# Server-only, optional. When set, the whole site asks for this key before
# showing anything. Set it (Sensitive) only in the Vercel project to keep private.
SITE_ACCESS_KEY=
# Optional build setting; no tracking is required to build.
NEXT_TELEMETRY_DISABLED=1
# PAYMENT_PROVIDER, SITE_URL, SMTP and Easypaisa secrets belong ONLY in Supabase,
# never in this directory or in NEXT_PUBLIC_/VITE_ variables.
