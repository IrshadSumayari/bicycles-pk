# Copy to supabase/.env (gitignored) for local Supabase. Never commit real keys.
# Hosted projects: set these in Authentication -> SMTP Settings instead (docs/operations/DEPLOY.md §4).
RESEND_API_KEY=re_your_resend_api_key
# A sender on a domain verified in Resend, e.g. orders@<domain>.
RESEND_FROM_EMAIL=orders@example.com
# true = local Auth email goes out through Resend; unset/false = stays in Mailpit.
SUPABASE_AUTH_EMAIL_SMTP_ENABLED=false
