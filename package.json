{
  "name": "bicycles-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern POS system built with React and Supabase",
  "keywords": [
    "react",
    "supabase",
    "pos",
    "point-of-sale",
    "system",
    "ecommerce"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "test:db": "supabase test db",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "restore:rehearsal": "powershell -ExecutionPolicy Bypass -File scripts/restore-rehearsal.ps1",
    "web:dev": "npm --prefix website run dev",
    "web:build": "npm --prefix website run build",
    "web:lint": "npm --prefix website run lint",
    "web:test": "npm --prefix website run test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "apexcharts": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-apexcharts": "1.7.0",
    "react-dom": "^19.3.1",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
